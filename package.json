{
  "name": "pomoquest",
  "version": "1.0.0",
  "private": true,
  "description": "Pomodoro RPG — ผจญภัยระหว่างโฟกัส (Pomodoro timer fused with an RPG adventure)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test:achievements": "node scripts/test-achievements.mjs",
    "test:daily": "node scripts/test-daily.mjs",
    "test:llm": "node scripts/test-llm.mjs",
    "test:events": "node scripts/test-events.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
